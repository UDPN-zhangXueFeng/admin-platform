# RBAC 后端 API 代理路径（与 td-manage 保持一致）
# 客户端 axios 使用相对路径 /aps，由 Next.js rewrites 代理到后端
NEXT_PUBLIC_API_BASE_URL=/aps

# 服务端请求直接打到后端
NEXT_SERVICE_SERVER_URL=http://10.0.48.123:30001/

# 动态 API 前缀（与 td-manage/.env 一致：CONFIG_ID=/api/base/）
# approval-manage 的三列表 + task/* + common/user/list 都拼 ${CONFIG_ID}v1/...
# 缺失 → URL 无 /api/base/ 前缀 → 后端 404 → 列表空
NEXT_PUBLIC_CONFIG_ID=/api/base/
