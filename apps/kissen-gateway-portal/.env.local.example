# Kissen Gateway Portal — local environment template.
# Copy to .env.local and adjust. .env.local is git-ignored (.gitignore: .env*.local).

# Nx project id resolved by loadProjectConfig (configs/kissen-gateway.json)
NX_PROJECT_ID=kissen-gateway

# Dev server port
PORT=3200

# Kissen gateway backend (next.config rewrites /kissen-api proxy target)
NEXT_SERVICE_SERVER_URL=http://10.0.7.87:8080

# Public API base used by the axios client
NEXT_PUBLIC_API_BASE_URL=/kissen-api/bankgw/portal

# Dev-only login prefill on the /login page (gated by NODE_ENV=development;
# unset or empty values disable the prefill). Internal test account only —
# never real production credentials.
NEXT_PUBLIC_DEV_LOGIN_NAME=bank_admin
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=Kissen@123
