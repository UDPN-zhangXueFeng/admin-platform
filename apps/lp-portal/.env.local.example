# Kissen LP Portal — local environment template.
# Copy to .env.local and adjust. .env.local is git-ignored (.gitignore: .env*.local).

# Dev-only login prefill on the /login page (gated by NODE_ENV=development;
# unset or empty values leave the field blank). Internal test account only —
# never real production credentials.
NEXT_PUBLIC_LP_DEV_LP_CODE=reddate
NEXT_PUBLIC_LP_DEV_LOGIN_NAME=reddate_admin
NEXT_PUBLIC_LP_DEV_PASSWORD=red@123456
