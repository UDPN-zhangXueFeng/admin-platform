{
  "project": {
    "id": "kissen-admin",
    "name": "Kissen Admin",
    "logo": "/logo.svg",
    "favicon": "/favicon.ico"
  },
  "theme": {
    "mode": "system",
    "colors": {
      "primary": "241.268 75.532% 63.137%",
      "background": "0 0% 100%",
      "foreground": "222.2 84% 4.9%",
      "primary-foreground": "210 40% 98%",
      "secondary": "210 40% 96%",
      "muted": "210 40% 96%",
      "accent": "210 40% 96%",
      "destructive": "0 84% 60%",
      "border": "214 32% 91%",
      "input": "214 32% 91%",
      "ring": "241.268 75.532% 63.137%"
    },
    "radius": "0.5rem",
    "fontFamily": {
      "sans": "Inter system-ui sans-serif",
      "mono": "JetBrains Mono monospace"
    }
  },
  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true,
      "singleExpand": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "dashboard",
      "bank-onboard",
      "bank-info",
      "bank-approval",
      "gateway-register",
      "lp-liquidity",
      "lp-info",
      "lp-pool",
      "lp-preauth",
      "lp-currency-pair",
      "lp-topup",
      "lp-water-level",
      "fx-rate",
      "currency-pair",
      "rate-config",
      "rate-push-log",
      "transaction",
      "tx-list",
      "tx-exception",
      "tx-reversal",
      "settlement",
      "settle-record",
      "settle-order",
      "split-transfer",
      "reconcile",
      "risk-compliance",
      "freeze",
      "monitor-rule",
      "monitor-hit",
      "approval-center",
      "system",
      "sys-user",
      "sys-role",
      "sys-menu",
      "currency",
      "workflow-config",
      "scheduled-task",
      "operate-log"
