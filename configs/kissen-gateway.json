{
  "project": {
    "id": "kissen-gateway",
    "name": "Kissen Gateway Portal",
    "logo": "/logo.svg",
    "favicon": "/favicon.ico"
  },
  "theme": {
    "mode": "system",
    "colors": {
      "primary": "241.268 75.532% 63.137%",
      "background": "0 0% 100%",
      "foreground": "222.2 84% 4.9%",
      "primary-foreground": "210 40% 98%",
      "secondary": "210 40% 96%",
      "muted": "210 40% 96%",
      "accent": "210 40% 96%",
      "destructive": "0 84% 60%",
      "border": "214 32% 91%",
      "input": "214 32% 91%",
      "ring": "241.268 75.532% 63.137%"
    },
    "radius": "0.5rem",
    "fontFamily": {
      "sans": "Inter system-ui sans-serif",
      "mono": "JetBrains Mono monospace"
    }
  },
  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "onboard",
      "dashboard",
      "tx",
      "market", "currencypair", "lp", "rate",
      "system", "user", "role", "menu", "log"
    ],
    "order": [
      {
        "id": "onboard",
        "icon": "FileCheck2",
        "label": "Onboarding Application",
        "path": "/onboard",
        "group": ""
      },
      {
        "id": "dashboard",
        "icon": "LayoutDashboard",
        "label": "Dashboard",
        "path": "/dashboard",
        "group": ""
      },
      {
        "id": "tx",
        "icon": "Receipt",
        "label": "Transaction Records",
        "path": "/tx",
        "group": ""
      },
      {
        "id": "market",
        "icon": "Coins",
        "label": "Business View",
        "path": "/market/currencypair",
        "group": "",
        "children": [
          { "id": "currencypair", "icon": "ArrowRightLeft", "label": "Currency Pair", "path": "/market/currencypair" },
          { "id": "lp",           "icon": "Building2",      "label": "LP List", "path": "/market/lp" },
          { "id": "rate",         "icon": "TrendingUp",     "label": "Exchange Rate",     "path": "/market/rate" }
        ]
      },
      {
        "id": "system",
        "icon": "Shield",
        "label": "System Management",
        "path": "/system/user",
        "group": "",
        "children": [
          { "id": "user", "icon": "Users",       "label": "User Management", "path": "/system/user" },
          { "id": "role", "icon": "ShieldCheck", "label": "Role Management", "path": "/system/role" },
          { "id": "menu", "icon": "ListTree",    "label": "Menu Permission", "path": "/system/menu" },
          { "id": "log",  "icon": "ScrollText",  "label": "Operation Log", "path": "/system/log", "group": "more" }
        ]
      }
    ],
    "dashboard": {
      "widgets": [
        { "id": "total-tx",     "type": "kpi", "title": "Total Transactions", "span": 1 },
        { "id": "pending-tx",   "type": "kpi", "title": "Pending Transactions", "span": 1 },
        { "id": "active-pairs", "type": "kpi", "title": "Active Currency Pairs", "span": 1 },
        { "id": "active-lps",   "type": "kpi", "title": "Active LP", "span": 1 }
      ]
    }
  },
  "i18n": {
    "defaultLocale": "en-US",
    "locales": ["en-US", "zh-CN"]
  },
  "features": {
    "darkMode": true,
    "multiTab": false,
    "fullscreen": true,
    "exportCSV": true,
    "bulkActions": true,
    "inactivityLogout": false
  }
}
