{
  "project": {
    "id": "kissen-gateway",
    "name": "Kissen Gateway Portal",
    "subtitle": "Stablecoin Management System",
    "logo": "/logo.svg",
    "favicon": "/favicon.svg"
  },
  "theme": {
    "mode": "system",
    "colors": {
      "primary": "241.268 75.532% 63.137%",
      "background": "0 0% 100%",
      "foreground": "222.2 84% 4.9%",
      "primary-foreground": "210 40% 98%",
      "secondary": "210 40% 96%",
      "muted": "210 40% 96%",
      "accent": "210 40% 96%",
      "destructive": "0 84% 60%",
      "border": "214 32% 91%",
      "input": "214 32% 91%",
      "ring": "241.268 75.532% 63.137%"
    },
    "radius": "0.5rem",
    "fontFamily": {
      "sans": "Inter system-ui sans-serif",
      "mono": "JetBrains Mono monospace"
    }
  },
  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "overview",
      "onboard",
      "token", "fx", "bank",
      "tx",
      "system", "user", "role", "menu", "log",
      "market", "currencypair", "lp", "rate"
    ],
    "order": [
      {
        "id": "overview",
        "icon": "Gauge",
        "label": "Overview",
        "path": "/overview",
        "group": ""
      },
      {
        "id": "onboard",
        "icon": "FileCheck2",
        "label": "Onboarding Application",
        "path": "/onboard",
        "group": ""
      },
      {
        "id": "token",
        "icon": "Coins",
        "label": "Token Management",
        "path": "/token/manage",
        "group": ""
      },
      {
        "id": "fx",
        "icon": "TrendingUp",
        "label": "FX Rate Query",
        "path": "/fx",
        "group": ""
      },
      {
        "id": "bank",
        "icon": "Search",
        "label": "Bank Query",
        "path": "/bank/query",
        "group": ""
      },
      {
        "id": "tx",
        "icon": "Receipt",
        "label": "Transaction Records",
        "path": "/tx",
        "group": ""
      },
      {
        "id": "system",
        "icon": "Shield",
        "label": "System Management",
        "path": "/system/user",
        "group": "",
        "children": [
          { "id": "user", "icon": "Users",       "label": "User Management", "path": "/system/user" },
          { "id": "role", "icon": "ShieldCheck", "label": "Role Management", "path": "/system/role" },
          { "id": "menu", "icon": "ListTree",    "label": "Menu Permission", "path": "/system/menu" },
          { "id": "log",  "icon": "ScrollText",  "label": "Operation Log", "path": "/system/log", "group": "more" },
          { "id": "ui",   "icon": "Settings",    "label": "UI Setting",     "path": "/system/ui" }
        ]
      }
    ]
  },
  "i18n": {
    "defaultLocale": "en-US",
    "locales": ["en-US", "zh-CN"]
  },
  "features": {
    "darkMode": true,
    "multiTab": false,
    "fullscreen": true,
    "exportCSV": true,
    "bulkActions": true,
    "inactivityLogout": false
  }
}
