{
  "project": {
    "id": "lp-portal",
    "name": "LP Portal",
    "logo": "/logo.svg",
    "favicon": "/favicon.ico"
  },
  "theme": {
    "mode": "system",
    "colors": {
      "primary": "241.268 75.532% 63.137%",
      "background": "0 0% 100%",
      "foreground": "222.2 84% 4.9%",
      "primary-foreground": "210 40% 98%",
      "secondary": "210 40% 96%",
      "muted": "210 40% 96%",
      "accent": "210 40% 96%",
      "destructive": "0 84% 60%",
      "border": "214 32% 91%",
      "input": "214 32% 91%",
      "ring": "241.268 75.532% 63.137%"
    },
    "radius": "0.5rem",
    "fontFamily": {
      "sans": "Inter system-ui sans-serif",
      "mono": "JetBrains Mono monospace"
    }
  },
  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "dashboard",
      "pool",
      "topup",
      "preauth",
      "pair",
      "rate",
      "tx-flow",
      "settle",
      "receipt",
      "notify",
      "syslog",
      "sys", "user", "role", "menu"
    ],
    "order": [
      {
        "id": "dashboard",
        "icon": "LayoutDashboard",
        "label": "Dashboard",
        "path": "/dashboard",
        "group": ""
      },
      {
        "id": "pool",
        "icon": "Wallet",
        "label": "Liquidity Pool Management",
        "path": "/pool",
        "group": ""
      },
      {
        "id": "preauth",
        "icon": "ShieldCheck",
        "label": "Pre-authorization Management",
        "path": "/preauth",
        "group": ""
      },
      {
        "id": "topup",
        "icon": "ArrowDownToLine",
        "label": "Top-up",
        "path": "/topup",
        "group": ""
      },
      {
        "id": "pair",
        "icon": "ArrowLeftRight",
        "label": "Currency Pair & Liquidity Pool",
        "path": "/pair",
        "group": ""
      },
      {
        "id": "rate",
        "icon": "TrendingUp",
        "label": "Exchange Rate",
        "path": "/rate",
        "group": ""
      },
      {
        "id": "tx-flow",
        "icon": "ListTree",
        "label": "Transaction Records",
        "path": "/tx-flow",
        "group": ""
      },
      {
        "id": "settle",
        "icon": "ReceiptText",
        "label": "Settlement",
        "path": "/settle",
        "group": ""
      },
      {
        "id": "receipt",
        "icon": "Download",
        "label": "Source Receipt Details",
        "path": "/receipt",
        "group": "",
        "disabled": false
      },
      {
        "id": "notify",
        "icon": "Bell",
        "label": "Notification Center",
        "path": "/notify",
        "group": "more"
      },
      {
        "id": "syslog",
        "icon": "ScrollText",
        "label": "Operation Log",
        "path": "/syslog",
        "group": "more"
      },
      {
        "id": "user",
        "icon": "Users",
        "label": "User Management",
        "path": "/sys/user",
        "group": "more"
      },
      {
        "id": "role",
        "icon": "ShieldCheck",
        "label": "Role Management",
        "path": "/sys/role",
        "group": "more"
      },
      {
        "id": "menu",
        "icon": "Menu",
        "label": "Menu & Permissions",
        "path": "/sys/menu",
        "group": "more"
      }
    ],
    "dashboard": {
      "widgets": [
        { "id": "pool-balance",    "type": "kpi", "title": "Liquidity Pool Balance", "span": 1 },
        { "id": "low-water-alert", "type": "kpi", "title": "Water Level Alert", "span": 1 },
        { "id": "pending-topup",   "type": "kpi", "title": "Pending Top-up", "span": 1 },
        { "id": "unread-notify",   "type": "kpi", "title": "Unread Notifications", "span": 1 }
      ]
    }
  },
  "i18n": {
    "defaultLocale": "en-US",
    "locales": ["en-US", "zh-CN"]
  },
  "features": {
    "darkMode": true,
    "multiTab": false,
    "fullscreen": true,
    "exportCSV": true,
    "bulkActions": true,
    "inactivityLogout": false
  }
}
