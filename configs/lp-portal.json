  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "dashboard",
      "token",
      "pool",
      "pair",
      "tx-flow",
      "split-settle",
      "syslog",
      "sys"
    ],
    "order": [
      {
        "id": "dashboard",
        "icon": "Gauge",
        "label": "Dashboard",
        "path": "/dashboard",
        "group": ""
      },
      {
        "id": "token",
        "icon": "Coins",
        "label": "Bank Token Directory",
        "path": "/token",
        "group": ""
      },
      {
        "id": "pool",
        "icon": "Wallet",
        "label": "Liquidity Pool Management",
        "path": "/pool",
        "group": ""
      },
      {
        "id": "pair",
        "icon": "ArrowLeftRight",
        "label": "Token Pair Management",
        "path": "/pair",
        "group": ""
      },
      {
        "id": "tx-flow",
        "icon": "ListTree",
        "label": "Transaction Records",
        "path": "/tx-flow",
        "group": ""
      },
      {
        "id": "split-settle",
        "icon": "Money",
        "label": "Splits & Settlement",
        "path": "/split-settle",
        "group": ""
      },
      {
        "id": "syslog",
        "icon": "ScrollText",
        "label": "Operation Log",
        "path": "/syslog",
        "group": "more"
      },
      {
        "id": "user",
        "icon": "Users",
        "label": "User Management",
        "path": "/sys/user",
        "group": "more"
      },
      {
        "id": "role",
        "icon": "ShieldCheck",
        "label": "Role Management",
        "path": "/sys/role",
        "group": "more"
      },
      {
        "id": "menu",
        "icon": "Menu",
        "label": "Menu & Permissions",
        "path": "/sys/menu",
        "group": "more"
      }
    ]
  },
  "i18n": {
    "defaultLocale": "en-US",
    "locales": [
      "en-US",
      "zh-CN"
    ]
  },
  "features": {
    "darkMode": true,
    "multiTab": false,
    "fullscreen": true,
    "exportCSV": true,
    "bulkActions": true,
    "inactivityLogout": false
  }
}
