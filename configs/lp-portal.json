  "layout": {
    "type": "sidebar",
    "sidebar": {
      "position": "left",
      "width": "260px",
      "collapsible": true,
      "collapsedWidth": "68px",
      "showIconsOnlyCollapsed": true
    },
    "header": {
      "sticky": true,
      "showProjectSwitcher": false,
      "showSearch": false,
      "showNotifications": true,
      "showUserMenu": true
    },
    "breadcrumb": {
      "enabled": true
    }
  },
  "modules": {
    "enabled": [
      "token",
      "pool",
      "pair",
      "split",
      "rate",
      "preauth",
      "tx-flow",
      "settle",
      "receipt",
      "syslog",
      "sys"
    ],
    "order": [
      {
        "id": "token",
        "icon": "Coins",
        "label": "Token Overview",
        "path": "/token",
        "group": ""
      },
      {
        "id": "pool",
        "icon": "Wallet",
        "label": "Liquidity Pool Management",
        "path": "/pool",
        "group": ""
      },
      {
        "id": "pair",
        "icon": "ArrowLeftRight",
        "label": "Currency Pair & Liquidity Pool",
        "path": "/pair",
        "group": ""
      },
      {
        "id": "split",
        "icon": "PieChart",
        "label": "My Splits",
        "path": "/split",
        "group": ""
      },
      {
        "id": "rate",
        "icon": "TrendingUp",
