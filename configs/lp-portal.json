        "label": "Transaction Records",
        "path": "/tx-flow",
        "group": ""
      },
      {
        "id": "settle",
        "icon": "ReceiptText",
        "label": "Settlement",
        "path": "/settle",
        "group": ""
      },
      {
        "id": "receipt",
        "icon": "Download",
        "label": "Source Receipt Details",
        "path": "/receipt",
        "group": "",
        "disabled": false
      },
      {
        "id": "syslog",
        "icon": "ScrollText",
        "label": "Operation Log",
        "path": "/syslog",
        "group": "more"
