  },
  "i18n": {
    "defaultLocale": "en-US",
    "locales": [
      "en-US",
      "zh-CN"
    ]
  },
  "features": {
    "darkMode": true,
    "multiTab": false,
    "fullscreen": true,
    "exportCSV": true,
    "bulkActions": true,
    "inactivityLogout": false
