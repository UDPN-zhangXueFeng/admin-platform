        "path": "/rate",
        "group": ""
      },
      {
        "id": "preauth",
        "icon": "ShieldCheck",
        "label": "Pre-auth Monitor",
        "path": "/preauth",
        "group": ""
      },
      {
        "id": "tx-flow",
