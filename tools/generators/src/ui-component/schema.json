{
  "cli": "nx",
  "id": "ui-component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name (kebab-case, e.g. 'accordion')",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "radix": {
      "type": "string",
      "description": "Radix primitive package name (e.g. '@radix-ui/react-accordion')",
      "default": ""
    }
  },
  "required": ["name"]
}
